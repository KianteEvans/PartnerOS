# ----------------------------------------------------------------------------
# PartnerOS environment. Copy to .env for local dev. NEVER commit a real .env.
# ----------------------------------------------------------------------------

# Core ----------------------------------------------------------------------
NODE_ENV=development

# Secure-by-default opt-down. ONLY honored when NODE_ENV !== 'production' AND no
# deployment marker is present (see src/env.ts). Setting this in a deployed
# environment is a hard boot failure, by design (Rule 3).
PARTNEROS_LOCAL_DEV=true

# Database ------------------------------------------------------------------
# The ONLY datastore (Rule 1). RLS is enforced in Postgres (Rule 2).
# PRODUCTION: managed Postgres (RDS etc.) requires TLS -- append
# `?sslmode=require` (or verify-full with a CA bundle) to BOTH URLs, e.g.
#   postgres://user:pass@host:5432/partneros?sslmode=require
DATABASE_URL=postgres://partneros:partneros@localhost:5432/partneros
# Connection used by migrations / RLS owner. Must be the table owner but should
# NOT have BYPASSRLS in production.
DATABASE_MIGRATOR_URL=postgres://partneros:partneros@localhost:5432/partneros

# Auth / OIDC ---------------------------------------------------------------
OIDC_ISSUER=http://localhost:4444
OIDC_CLIENT_ID=partneros-local
OIDC_CLIENT_SECRET=local-stub-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT session signing. 32+ bytes of base64url. Generated per-deploy from a KMS.
SESSION_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS0zMmJ5dGVzLW1pbg

# Redis (rate limiting) -----------------------------------------------------
# When unset in dev, an in-memory adapter is used. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (S3-compatible) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=partneros-evidence
S3_ACCESS_KEY_ID=local-stub
S3_SECRET_ACCESS_KEY=local-stub-secret
S3_FORCE_PATH_STYLE=true

# Malware scan webhook. Fail-closed: an unverified/failed scan blocks access.
MALWARE_SCAN_WEBHOOK_SECRET=local-scan-hmac-secret

# AI features (optional) ----------------------------------------------------
# Enables the in-app "Ask AWS" assistant on the Assessments page, which grounds
# answers in official AWS docs via the AWS Knowledge MCP server. Leave blank to
# disable (the feature degrades gracefully). Never commit a real key.
ANTHROPIC_API_KEY=

# Observability (optional) --------------------------------------------------
# Error-level structured log events are POSTed here (fire-and-forget) so a
# Sentry-style collector can be attached without an SDK. Blank => stdout only.
ERROR_REPORT_URL=

# BD lead sync (optional) ---------------------------------------------------
# Bearer token for the read-only /api/integrations/bd-leads feed that the
# standalone BDAgent app pulls inbound "Book a demo" leads from. Blank => 401.
BD_SYNC_TOKEN=

# Deployment marker (set by the platform, NOT by humans). Presence forbids
# PARTNEROS_LOCAL_DEV. Leave blank locally.
PARTNEROS_DEPLOY_ENV=
